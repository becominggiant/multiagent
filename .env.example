# OpenAI API Key for GPT and content generation
OPENAI_API_KEY=your_openai_api_key_here

# Social Media Platform API Keys (optional - system works in simulation mode without these)
TIKTOK_API_KEY=your_tiktok_api_key
TIKTOK_API_SECRET=your_tiktok_api_secret

INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Optional: Custom model endpoints
CUSTOM_LLM_ENDPOINT=your_custom_llm_endpoint
CUSTOM_WHISPER_ENDPOINT=your_custom_whisper_endpoint